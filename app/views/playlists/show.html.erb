<div class="max-w-2xl mx-auto bg-white rounded-lg shadow p-8 mt-10">
  <h1 class="text-2xl font-bold mb-4"><%= @playlist.name %></h1>
  <h2 class="text-xl font-semibold mb-4">Tracks in this Playlist</h2>
  <button id="play-all-btn" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-full font-semibold mb-4 shadow flex items-center gap-2">
    ▶️ Play All
  </button>
  <ul id="playlist-tracks" class="mb-6 space-y-2">
    <% @playlist.tracks.each do |track| %>
      <li class="flex items-center justify-between bg-gray-50 rounded px-4 py-2 shadow-sm">
        <a href="#" 
           class="play-btn text-green-700 font-semibold hover:underline"
           data-audio="<%= track.audio_file %>"
           data-title="<%= track.title %>"
           data-artist="<%= track.artist.name %>"
           data-cover="<%= track.album&.cover_image %>">
          <%= track.title %>
        </a>
        <%= button_to "Remove", remove_track_playlist_path(@playlist, track_id: track.id), method: :delete, class: "text-red-500 px-3 py-1 rounded hover:bg-red-100 text-sm font-semibold" %>
      </li>
    <% end %>
  </ul>

  <%= link_to "Add Tracks to Playlist", add_tracks_playlist_path(@playlist), class: "bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded mb-4 inline-block font-semibold shadow" %>
  <%= link_to "Back to Playlists", playlists_path, class: "inline-block mt-8 text-blue-600 underline" %>
</div>

<script>
  // Play All logic
  document.getElementById('play-all-btn').addEventListener('click', function() {
    const playLinks = Array.from(document.querySelectorAll('.play-btn'));
    if (playLinks.length > 0) {
      playLinks[0].click();
    }
  });
</script>