<div class="max-w-3xl mx-auto bg-white rounded-lg shadow p-8 mt-8">
  <div class="flex items-center gap-6 mb-6">
    <div class="w-32 h-32 bg-gray-200 rounded-lg border"></div>
    <div>
      <h1 class="text-3xl font-bold mb-2"><%= @artist.name %></h1>
      <p class="text-gray-600"><%= @artist.bio %></p>
    </div>
  </div>

  <h2 class="text-xl font-semibold mb-2 mt-6">Top 5 Tracks</h2>
  <ul class="mb-6">
    <% @artist.tracks.limit(5).each do |track| %>
      <li class="flex items-center gap-2 mb-2">
        <% if track.audio_file.present? %>
          <button 
            class="play-btn bg-gradient-to-r from-green-400 to-green-600 text-white px-2 py-1 rounded-full shadow hover:scale-110 transition-all"
            data-audio="<%= track.audio_file %>"
            data-title="<%= track.title %>"
            data-artist="<%= @artist.name %>"
            data-cover="<%= track.album&.cover_image %>">
            ▶️
          </button>
        <% end %>
        <span class="font-semibold cursor-pointer track-title"
              data-audio="<%= track.audio_file %>"
              data-title="<%= track.title %>"
              data-artist="<%= @artist.name %>"
              data-cover="<%= track.album&.cover_image %>">
          <%= track.title %>
        </span>
        <span class="text-gray-500 text-sm">(<%= track.album.title %>)</span>
      </li>
    <% end %>
  </ul>

  <h2 class="text-xl font-semibold mb-2">Albums</h2>
  <ul>
    <% @artist.albums.each do |album| %>
      <li class="mb-1">
        <%= link_to album.title, album_path(album), class: "text-blue-600 underline font-semibold" %>
        <span class="text-gray-500 text-sm">(<%= pluralize(album.tracks.count, "track") %>)</span>
      </li>
    <% end %>
  </ul>

  <div class="mt-8 flex gap-4">
    <%= link_to "Edit", edit_artist_path(@artist), class: "bg-yellow-500 text-white px-4 py-2 rounded" %>
    <%= button_to "Delete", artist_path(@artist), method: :delete, data: { confirm: "Are you sure?" }, class: "bg-red-500 text-white px-4 py-2 rounded" %>
    <%= link_to "Back to Artists", artists_path, class: "text-blue-600 underline ml-4" %>
  </div>
</div>

<script>
  // Semua tombol play dan judul track akan mengontrol player bar utama di layout
  document.addEventListener("DOMContentLoaded", function() {
    function playToMainPlayer(el) {
      const playerBar = document.getElementById('player-bar');
      const player = document.getElementById('main-player');
      const cover = document.getElementById('player-cover');
      const title = document.getElementById('player-title');
      const artist = document.getElementById('player-artist');
      const src = el.getAttribute('data-audio');
      const coverUrl = el.getAttribute('data-cover');
      const trackTitle = el.getAttribute('data-title');
      const trackArtist = el.getAttribute('data-artist');
      if (!src) return;
      player.src = src.startsWith('/') ? window.location.origin + src : src;
      title.textContent = trackTitle || '';
      artist.textContent = trackArtist || '';
      if (coverUrl) {
        cover.src = coverUrl.startsWith('/') ? window.location.origin + coverUrl : coverUrl;
        cover.classList.remove('hidden');
      } else {
        cover.src = '';
        cover.classList.add('hidden');
      }
      playerBar.classList.remove('hidden');
      player.play();
    }

    document.querySelectorAll('.play-btn, .track-title').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        playToMainPlayer(this);
      });
    });
  });
</script>