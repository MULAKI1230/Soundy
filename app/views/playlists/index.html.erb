<div class="max-w-2xl mx-auto bg-white rounded-lg shadow p-8 mt-10">
  <h1 class="text-2xl font-bold mb-6">Playlists</h1>

  <div class="flex flex-col md:flex-row md:items-center gap-4 mb-8">
    <%= link_to "Create New Playlist", new_playlist_path, class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded shadow font-semibold" %>
    <%= form_with url: playlists_path, method: :get, local: true, class: "flex gap-2 flex-1" do %>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="Cari playlist..." class="border border-gray-300 p-2 rounded w-full focus:border-blue-400 focus:ring-blue-400" />
      <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded shadow">Cari</button>
    <% end %>
  </div>

  <ul class="space-y-3">
    <% @playlists.each do |playlist| %>
      <li class="bg-gray-50 rounded p-4 shadow flex items-center justify-between">
        <div>
          <%= link_to playlist.name, playlist_path(playlist), class: "text-green-700 underline font-semibold text-lg" %>
          <span class="text-gray-500 text-sm ml-2">(<%= pluralize(playlist.tracks.count, "track") %>)</span>
        </div>
        <div>
          <%= button_to "Delete", playlist_path(playlist), method: :delete, data: { confirm: "Are you sure you want to delete this playlist?" }, class: "bg-red-500 hover:bg-red-600 text-white px-4 py-2 rounded shadow text-sm" %>
        </div>
      </li>
    <% end %>
  </ul>

  <%= link_to "Back to Tracks", tracks_path, class: "inline-block mt-8 text-blue-600 underline" %>
</div>