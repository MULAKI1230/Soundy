<div class="max-w-4xl mx-auto bg-white rounded-lg shadow p-8 mt-8">
  <h1 class="text-2xl font-bold mb-6">Daftar Artis</h1>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <% @artists.each do |artist| %>
      <div class="bg-gray-50 rounded-lg shadow p-4 flex flex-col items-center">
        <div class="text-center">
          <h2 class="font-bold text-lg mb-1"><%= artist.name %></h2>
          <p class="text-gray-500 text-sm mb-2"><%= truncate(artist.bio, length: 60) %></p>
          <%= link_to "Lihat Detail", artist_path(artist), class: "text-blue-600 underline font-semibold" %>
        </div>
      </div>
    <% end %>
  </div>
  <div class="mt-8">
    <%= link_to "Tambah Artis Baru", new_artist_path, class: "bg-green-500 text-white px-4 py-2 rounded" %>
  </div>
</div>